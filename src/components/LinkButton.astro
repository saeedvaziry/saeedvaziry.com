---
export interface Props {
  id?: string;
  href: string;
  class?: string;
  ariaLabel?: string;
  title?: string;
  disabled?: boolean;
  pill?: boolean;
}

const {
  id,
  href,
  class: className = "",
  ariaLabel,
  title,
  disabled = false,
  pill = false,
} = Astro.props;
---

{
  disabled ? (
    <span
      id={id}
      class:list={[
        "group inline-block",
        className,
        { "border border-border px-5 py-2.5": pill },
      ]}
      title={title}
      aria-disabled={disabled}
    >
      <slot />
    </span>
  ) : (
    <a
      id={id}
      {href}
      class:list={[
        "group inline-block hover:text-accent",
        className,
        { "border border-border px-5 py-2.5": pill },
      ]}
      aria-label={ariaLabel}
      title={title}
    >
      <slot />
    </a>
  )
}
