<section id="about-strip" class="mx-auto max-w-6xl px-4 py-16">
  <div
    class="flex flex-col items-start gap-6 rounded-2xl border border-border bg-card p-6 sm:flex-row sm:items-center sm:p-8"
  >
    <img
      src="/avatar.jpg"
      alt="Saeed Vaziry"
      width="96"
      height="96"
      loading="lazy"
      class="size-20 rounded-full object-cover sm:size-24"
    />
    <div>
      <h2 class="font-display text-2xl">About me</h2>
      <p class="mt-2 max-w-2xl text-foreground/80">
        I am a full-time software engineer who has been building open source
        in every spare hour since 2010. That hobby turned into products used
        by teams around the world, and now into helping companies bring AI
        into their own products.
      </p>
      <a
        href="/about"
        class="mt-3 inline-block font-medium text-accent underline decoration-dashed underline-offset-4"
      >
        More about me
      </a>
    </div>
  </div>
</section>
