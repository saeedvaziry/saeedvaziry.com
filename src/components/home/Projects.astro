---
import type { ImageMetadata } from "astro";
import {
  PROJECTS,
  PROJECT_GROUP_META,
  type Project,
  type ProjectGroup,
} from "@/data/projects";

// Inline SVGs can read the theme's CSS variables, so they follow light and
// dark mode. Raster screenshots (when they replace the placeholders later)
// render as plain images.
const svgModules = import.meta.glob<string>("/src/assets/projects/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const rasterModules = import.meta.glob<ImageMetadata>(
  "/src/assets/projects/*.{png,jpg,jpeg,webp,avif}",
  { import: "default", eager: true }
);

function projectImage(slug: string) {
  const svgKey = Object.keys(svgModules).find(key =>
    key.endsWith(`/${slug}.svg`)
  );
  if (svgKey) {
    return { kind: "svg" as const, html: svgModules[svgKey] };
  }
  const rasterKey = Object.keys(rasterModules).find(key =>
    new RegExp(`/${slug}\\.(png|jpe?g|webp|avif)$`).test(key)
  );
  if (rasterKey) {
    return { kind: "img" as const, src: rasterModules[rasterKey].src };
  }
  // Theme-aware pair: <slug>-light.* and <slug>-dark.* swap with the site theme.
  const ext = "(png|jpe?g|webp|avif)";
  const lightKey = Object.keys(rasterModules).find(key =>
    new RegExp(`/${slug}-light\\.${ext}$`).test(key)
  );
  const darkKey = Object.keys(rasterModules).find(key =>
    new RegExp(`/${slug}-dark\\.${ext}$`).test(key)
  );
  if (lightKey && darkKey) {
    return {
      kind: "dual" as const,
      light: rasterModules[lightKey].src,
      dark: rasterModules[darkKey].src,
    };
  }
  return null;
}

const featured: Project[] = PROJECTS.filter(project => project.featured);

const GROUP_ORDER: ProjectGroup[] = [
  "active-oss",
  "maintained",
  "commercial",
  "fun",
];

const groups = GROUP_ORDER.map(group => ({
  group,
  label: PROJECT_GROUP_META[group],
  projects: PROJECTS.filter(
    project => project.group === group && !project.featured
  ),
})).filter(entry => entry.projects.length > 0);
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-16">
  <h2 class="font-display text-3xl sm:text-4xl">Projects</h2>
  <p class="mt-3 max-w-2xl text-foreground/75">
    Open source tools and products I build and maintain.
  </p>

  <ul class="mt-10 grid gap-6 sm:grid-cols-2">
    {
      featured.map(project => {
        const image = projectImage(project.image);
        return (
          <li>
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block overflow-hidden border border-border bg-card transition-colors hover:border-accent"
            >
              {image?.kind === "svg" && (
                <div
                  class="[&>svg]:block [&>svg]:h-auto [&>svg]:w-full"
                  set:html={image.html}
                />
              )}
              {image?.kind === "img" && (
                <img
                  src={image.src}
                  alt={`${project.name} screenshot`}
                  loading="lazy"
                  class="block w-full"
                />
              )}
              {image?.kind === "dual" && (
                <Fragment>
                  <img
                    src={image.light}
                    alt={`${project.name} screenshot`}
                    loading="lazy"
                    class="block w-full dark:hidden"
                  />
                  <img
                    src={image.dark}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    class="hidden w-full dark:block"
                  />
                </Fragment>
              )}
              <div class="p-5">
                <h3 class="font-display text-xl text-foreground group-hover:text-accent">
                  {project.name}
                </h3>
                <p class="mt-1 text-foreground/75">{project.tagline}</p>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>

  <div class="mt-12 space-y-10">
    {
      groups.map(entry => (
        <div>
          <h3 class="text-sm font-semibold text-foreground/60 uppercase">
            {entry.label}
          </h3>
          <ul class="mt-3 divide-y divide-border">
            {entry.projects.map(project => (
              <li>
                <a
                  href={project.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex flex-col gap-1 py-3 transition-colors hover:text-accent sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
                >
                  <span class="font-medium">{project.name}</span>
                  <span class="text-sm text-foreground/70">
                    {project.tagline}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
