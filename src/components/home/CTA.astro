---
import { CAL_LINK } from "@/constants";
---

<section id="contact" class="mx-auto max-w-6xl px-4 py-16">
  <div
    class="rounded-2xl border border-border bg-accent-soft px-6 py-12 text-center sm:px-12"
  >
    <h2 class="font-display text-3xl sm:text-4xl">
      Let's build the tool your team is missing
    </h2>
    <p class="mx-auto mt-3 max-w-xl text-foreground/80">
      Tell me what slows your team down and we will ship the fix together.
    </p>
    <a
      href={CAL_LINK}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-8 inline-block rounded-full bg-accent px-8 py-3 font-medium text-accent-foreground transition-colors hover:opacity-90"
    >
      Book a call
    </a>
  </div>
</section>
