---
import { CAL_LINK } from "@/constants";
---

<section id="hero" class="mx-auto max-w-6xl px-4 pt-14 pb-16 sm:pt-20">
  <p class="mb-4 text-sm font-medium tracking-[0.2em] text-accent uppercase">
    Hi there &#128075;
  </p>
  <h1 class="font-display text-4xl leading-tight sm:text-6xl">
    I am a software engineer.
    <span class="block text-foreground/75">I build tools for developers.</span>
  </h1>
  <p class="mt-6 max-w-2xl text-lg text-foreground/80">
    What I offer: designing and building developer tools, from CLIs and internal
    platforms to AI-powered features, plus hands-on help bringing AI into your
    product.
  </p>
  <div class="mt-8 flex flex-wrap items-center gap-4">
    <a
      href={CAL_LINK}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-full bg-accent px-6 py-3 font-medium text-accent-foreground transition-colors hover:opacity-90"
    >
      Book a call
    </a>
    <a
      href="/posts"
      class="rounded-full border border-border px-6 py-3 font-medium text-foreground transition-colors hover:border-accent hover:text-accent"
    >
      Read the blog
    </a>
  </div>
</section>
