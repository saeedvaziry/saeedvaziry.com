---
import { CONTACT_LINK } from "@/constants";
import Terminal from "@/components/home/Terminal.astro";
---

<section id="hero" class="mx-auto max-w-6xl px-4 pt-14 pb-16 sm:pt-20">
  <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-14">
    <div>
      <p class="mb-4 text-sm font-medium text-accent uppercase">
        Hi there &#128075;
      </p>
      <h1
        class="font-display text-4xl leading-[1.1] font-semibold tracking-tight sm:text-5xl xl:text-6xl"
      >
        I am a software engineer.
        <span class="block text-foreground/75"
          >I build tools for developers.</span
        >
      </h1>
      <p class="mt-6 max-w-xl text-lg text-foreground/80">
        What I offer: designing and building developer tools, from CLIs and
        internal platforms to AI-powered features, plus hands-on help bringing
        AI into your product.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={CONTACT_LINK}
          class="bg-accent px-6 py-3 font-medium text-accent-foreground transition-colors hover:opacity-90"
        >
          Get in touch
        </a>
        <a
          href="/posts"
          class="border border-border px-6 py-3 font-medium text-foreground transition-colors hover:border-accent hover:text-accent"
        >
          Read the blog
        </a>
      </div>
    </div>
    <Terminal />
  </div>
</section>
