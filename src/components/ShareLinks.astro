---
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";

const URL = Astro.url;
---

<div
  class="flex flex-col flex-wrap items-center justify-center gap-2 sm:items-start"
>
  <span
    class="text-xs font-medium text-foreground/60 uppercase"
  >
    Share this post on:
  </span>
  <div class="flex flex-wrap items-center gap-2">
    {
      SHARE_LINKS.map(social => (
        <LinkButton href={`${social.href + URL}`} title={social.linkTitle}>
          <span class="flex size-10 items-center justify-center border border-border bg-card transition-colors group-hover:border-accent group-hover:text-accent">
            <social.icon class="size-5 fill-transparent stroke-current stroke-2" />
          </span>
          <span class="sr-only">{social.linkTitle}</span>
        </LinkButton>
      ))
    }
  </div>
</div>
