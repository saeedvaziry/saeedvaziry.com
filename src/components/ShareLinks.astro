---
import { SHARE_LINKS } from "@/constants";
import LinkButton from "./LinkButton.astro";

const URL = Astro.url;
---

<div
  class="flex flex-col flex-wrap items-center justify-center gap-2 sm:items-start"
>
  <span
    class="text-xs font-medium tracking-[0.15em] text-foreground/60 uppercase"
  >
    Share this post on:
  </span>
  <div class="flex flex-wrap items-center gap-2">
    {
      SHARE_LINKS.map(social => (
        <LinkButton
          href={`${social.href + URL}`}
          class="rounded-full border border-border bg-card p-2.5 transition-colors hover:border-accent hover:text-accent"
          title={social.linkTitle}
        >
          <social.icon class="inline-block size-5 fill-transparent stroke-current stroke-2" />
          <span class="sr-only">{social.linkTitle}</span>
        </LinkButton>
      ))
    }
  </div>
</div>
