---
import IconHash from "@/assets/icons/IconHash.svg";

export interface Props {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
}

const { tag, tagName, size = "sm" } = Astro.props;
---

<li class="group inline-block group-hover:cursor-pointer">
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "inline-flex items-center gap-1 bg-muted transition-colors hover:bg-accent-soft hover:text-accent focus-visible:bg-accent-soft focus-visible:text-accent",
      { "px-3 py-1 text-sm": size === "sm" },
      { "px-4 py-1.5 text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "inline-block opacity-80",
        { "size-3.5": size === "sm" },
        { "size-5": size === "lg" },
      ]}
    />
    <span>{tagName}</span>
  </a>
</li>
