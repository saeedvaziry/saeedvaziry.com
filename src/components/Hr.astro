---
export interface Props {
  noPadding?: boolean;
  ariaHidden?: boolean;
  wide?: boolean;
}

const { noPadding = false, ariaHidden = true, wide = false } = Astro.props;
---

<div
  class={`mx-auto ${wide ? "max-w-6xl" : "max-w-3xl"} ${noPadding ? "px-0" : "px-4"}`}
>
  <hr class="border-dashed border-border" aria-hidden={ariaHidden} />
</div>
