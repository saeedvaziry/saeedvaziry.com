---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/home/Hero.astro";
import Services from "@/components/home/Services.astro";
import Projects from "@/components/home/Projects.astro";
import LatestWriting from "@/components/home/LatestWriting.astro";
import AboutStrip from "@/components/home/AboutStrip.astro";
import CTA from "@/components/home/CTA.astro";
---

<Layout>
  <Header wide />
  <main id="main-content" data-backurl="/">
    <Hero />
    <Services />
    <Projects />
    <LatestWriting />
    <AboutStrip />
    <CTA />
  </main>
  <Footer wide />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent: HTMLElement | null =
      document.querySelector("#main-content");
    const backUrl = mainContent?.dataset?.backurl;
    if (backUrl) {
      sessionStorage.setItem("backUrl", backUrl);
    }
  });
</script>
